<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="Luna Ravintola - The Best Pizza in Turku. Huge portions, fresh ingredients, unforgettable taste.">
    <title>Luna Ravintola | Turku</title>
    <link rel="canonical" href="https://luna-ravintola.vercel.app/">
    <link rel="icon" type="image/png" href="assets/logo.png">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://luna-ravintola.vercel.app/">
    <meta property="og:title" content="Luna Ravintola | Turku's Best Pizza">
    <meta property="og:description"
        content="Huge portions, fresh ingredients, and unforgettable taste. Ilpoinen, Turku.">
    <meta property="og:image" content="https://luna-ravintola.vercel.app/assets/pizza_prosciutto.png">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:title" content="Luna Ravintola | Turku's Best Pizza">
    <meta property="twitter:image" content="https://luna-ravintola.vercel.app/assets/pizza_prosciutto.png">

    <!-- Google Analytics (GA4) -->
    <!-- Replace G-XXXXXXXXXX with your actual Measurement ID -->
    <!-- <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script> -->

    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Restaurant",
      "name": "Luna Ravintola",
      "image": "https://luna-ravintola.vercel.app/assets/interior.jpg",
      "url": "https://luna-ravintola.vercel.app/",
      "telephone": "+358413154126",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Lauklähteenkatu 10",
        "addressLocality": "Turku",
        "postalCode": "20740",
        "addressCountry": "FI"
      },
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday"], "opens": "10:30", "closes": "21:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Friday","Saturday"], "opens": "10:30", "closes": "22:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "12:00", "closes": "21:00" }
      ],
      "servesCuisine": ["Pizza", "Burger", "Kebab"],
      "priceRange": "$$",
      "aggregateRating": { "@type": "AggregateRating", "ratingValue": "5.0", "reviewCount": "6" }
    }
    </script>

    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="styles.css?v=8">
    <link rel="preload" as="image" href="assets/pizza_prosciutto.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>

    <!-- Global Background Particles -->
    <div class="global-particles">
        <i class="fas fa-pizza-slice gp"></i><i class="fas fa-star gp"></i><i class="fas fa-pizza-slice gp"></i>
        <i class="fas fa-fire gp"></i><i class="fas fa-star gp"></i><i class="fas fa-pizza-slice gp"></i>
        <i class="fas fa-pepper-hot gp"></i><i class="fas fa-star gp"></i><i class="fas fa-pizza-slice gp"></i>
        <i class="fas fa-fire gp"></i><i class="fas fa-pizza-slice gp"></i><i class="fas fa-star gp"></i>
        <i class="fas fa-fire gp"></i><i class="fas fa-pepper-hot gp"></i><i class="fas fa-pizza-slice gp"></i>
        <i class="fas fa-star gp"></i><i class="fas fa-fire gp"></i><i class="fas fa-pepper-hot gp"></i>
        <i class="fas fa-pizza-slice gp"></i><i class="fas fa-star gp"></i>
    </div>

    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <a href="#" class="logo">
                <div class="logo-icon"><i class="fas fa-pizza-slice"></i></div>
                <div>
                    <div class="logo-text">LUNA</div>
                    <span class="logo-sub">RAVINTOLA</span>
                </div>
            </a>
            <div class="nav-links desktop-nav">
                <a href="#home" data-en="HOME" data-fi="KOTI">HOME</a>
                <a href="#menu" data-en="MENU" data-fi="RUOKALISTA">MENU</a>
                <a href="#reviews" data-en="REVIEWS" data-fi="ARVOSTELUT">REVIEWS</a>
                <a href="#location" data-en="CONTACT" data-fi="YHTEYSTIEDOT">CONTACT</a>
            </div>
            <div class="nav-controls">
                <button id="theme-toggle" class="icon-btn" aria-label="Toggle Dark Mode"><i
                        class="fas fa-moon"></i></button>
                <a href="https://www.facebook.com/profile.php?id=61585046934347" target="_blank" class="icon-btn"
                    aria-label="Facebook">
                    <i class="fab fa-facebook"></i>
                </a>
                <button id="lang-toggle" class="lang-btn"><i class="fas fa-globe"></i> <span
                        id="lang-text">EN</span></button>
                <button class="hamburger icon-btn" aria-label="Menu"><i class="fas fa-bars"></i></button>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu-overlay">
        <button class="close-menu"><i class="fas fa-times"></i></button>
        <div class="mobile-menu-links">
            <a href="#home">Home</a>
            <a href="#menu">Menu</a>
            <a href="#reviews">Reviews</a>
            <a href="#location">Contact</a>
        </div>
    </div>

    <!-- Hero Section -->
    <section id="home" class="hero animate-on-scroll">
        <div class="hero-slideshow">
            <img src="assets/pizza_prosciutto.png" alt="Prosciutto Pizza" class="slide active">
            <img src="assets/interior.jpg" alt="Luna Ravintola Interior" class="slide" loading="lazy">
            <img src="assets/pizza_mexicana.jpg" alt="Mexicana Pizza" class="slide">
            <img src="assets/pizza_bbq.jpg" alt="BBQ Pizza" class="slide">
            <img src="assets/pizza_ham_arugula.jpg" alt="Ham Arugula Pizza" class="slide">
        </div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="rating-badge">
                <div class="stars"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i
                        class="fas fa-star"></i><i class="fas fa-star"></i></div>
                <span>5.0 (6 Google Reviews)</span>
            </div>
            <h1><span data-en="The Best Pizza" data-fi="Paras Pizza">The Best Pizza</span> <br> <span class="orange"
                    data-en="in Turku" data-fi="Turussa">in Turku</span></h1>
            <p data-en="Huge portions. Fresh ingredients. Unforgettable taste."
                data-fi="Valtavat annokset. Tuoreet raaka-aineet. Unohtumaton maku.">Huge portions. Fresh ingredients.
                Unforgettable taste.</p>
            <div class="hero-buttons">
                <a href="#menu" class="btn btn-primary"><i class="fas fa-utensils"></i> <span data-en="View Menu"
                        data-fi="Katso Ruokalista">View Menu</span></a>
                <a href="tel:0413154126" class="btn btn-white"><i class="fas fa-phone"></i> 041 3154126</a>
            </div>
        </div>
        <div class="hero-open-widget">
            <div class="status-row">
                <div class="status-dot"></div>
                <span data-en="OPEN TODAY" data-fi="AVOINNA">OPEN TODAY</span>
            </div>
            <div class="hours-text"><strong>10:30 - 21:00</strong></div>
        </div>
    </section>

    <!-- Our Story Section -->
    <section id="story" class="section animate-on-scroll">
        <div class="container story-container">
            <div class="story-image">
                <img src="assets/interior.jpg" alt="Luna Ravintola Interior" loading="lazy">
                <div class="story-badge"><i class="fas fa-heart"></i> <span data-en="Family Owned"
                        data-fi="Perheyritys">Family Owned</span></div>
            </div>
            <div class="story-content">
                <span class="section-label" data-en="Our Story" data-fi="Meidän Tarina">Our Story</span>
                <h2 class="section-title" data-en="New in the Neighborhood" data-fi="Uusi Naapurustossa">New in the
                    Neighborhood</h2>
                <p data-en="At Luna Ravintola, we believe pizza is more than just food—it’s an experience. Located in the heart of Ilpoinen, we are a proud family-owned restaurant dedicated to one simple mission: serving the best, most generous portions in Turku. We use only the freshest ingredients, hand-picked daily, to create unforgettable flavors that keep our customers coming back."
                    data-fi="Luna Ravintolassa uskomme, että pizza on enemmän kuin vain ruokaa – se on elämys. Sijaitsemme Ilpoisten sydämessä ja olemme ylpeä perheyritys, jolla on yksinkertainen tehtävä: tarjota Turun parhaat ja runsaimmat annokset. Käytämme vain tuoreimpia, päivittäin valikoituja raaka-aineita luodaksemme unohtumattomia makuja.">
                    At Luna Ravintola, we believe pizza is more than just food—it’s an experience. Located in the heart
                    of Ilpoinen, we are a proud family-owned restaurant dedicated to one simple mission: serving the
                    best, most generous portions in Turku. We use only the freshest ingredients, hand-picked daily, to
                    create unforgettable flavors that keep our customers coming back.
                </p>
                <div class="badges">
                    <div class="badge-item">
                        <div class="check-icon"><i class="fas fa-check"></i></div> <span data-en="Kid Friendly"
                            data-fi="Lapsiystävällinen">Kid Friendly</span>
                    </div>
                    <div class="badge-item">
                        <div class="check-icon"><i class="fas fa-check"></i></div> <span data-en="Takeaway"
                            data-fi="Noutoruoka">Takeaway</span>
                    </div>
                    <div class="badge-item">
                        <div class="check-icon"><i class="fas fa-check"></i></div> <span data-en="Dine In"
                            data-fi="Syö paikan päällä">Dine In</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Menu Section -->
